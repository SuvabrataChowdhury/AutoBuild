load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Inputs Bazel tracks for cache invalidation — if none of these change,
# both targets below are skipped entirely (cache hit).
_SRCS = glob(
    ["src/**", "*.json", "*.js", "*.ts"],
    exclude = ["src/gen/**"],
)

# Runs the full NPM test suite.
# Run with: bazel test //pipeline-ui:test
sh_test(
    name = "test",
    srcs = ["run_tests.sh"],
    data = _SRCS + ["//apis/openapi-spec:all"],
    tags = ["manual"],
)

