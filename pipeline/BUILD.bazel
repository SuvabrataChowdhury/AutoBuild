load("@rules_java//java:defs.bzl", "java_library", "java_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Inputs Bazel tracks for cache invalidation — if none of these change,
# both targets below are skipped entirely (cache hit).
_SRCS = glob(
    ["src/**", "pom.xml"],
    exclude = ["target/**"],
)

# Compiles and packages the service via Maven.
# Output: pipeline.jar in bazel-bin/pipeline/
# Run with: bazel build //pipeline:jar
genrule(
    name = "jar",
    srcs = _SRCS,
    outs = ["pipeline.jar"],
    cmd = """
        export HOME=$$(echo ~)
        OUT=$$PWD/$@
        cd pipeline
        ./mvnw --batch-mode -q package -DskipTests
        cp target/pipeline-*.jar $$OUT
    """,
    local = True,  # Maven needs network access for first run; not sandboxed
)

# Runs the full Maven test suite.
# Run with: bazel test //pipeline:test
sh_test(
    name = "test",
    srcs = ["run_tests.sh"],
    data = _SRCS,
    tags = ["manual", "local"],
)

